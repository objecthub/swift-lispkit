(import (lispkit base)
        (lispkit hashtable)
        (lispkit json)
        (lispkit yaml)
        (only (lispkit system) path system-directory delete-file-or-directory))

;;; Output

;; Prints the result of an evaluation. YAML values are printed as compact YAML text
;; with sorted mapping keys, which makes the output deterministic.
(define (display-result x)
  (cond ((yaml? x)
         (let ((text (yaml->string x '((flow-style . #t) (sort-keys . #t) (line-width . #f)))))
           (display (substring text 0 (- (string-length text) 1)))))
        ((pair? x)
         (display "(")
         (display-result (car x))
         (let loop ((rest (cdr x)))
           (cond ((null? rest))
                 ((pair? rest) (display " ") (display-result (car rest)) (loop (cdr rest)))
                 (else (display " . ") (display-result rest))))
         (display ")"))
        (else
         (write x))))

;; Writes an expression like `write`, but abbreviates quoted data.
(define (write-expr expr)
  (cond ((and (pair? expr) (eq? (car expr) 'quote) (pair? (cdr expr)) (null? (cddr expr)))
         (display "'")
         (write-expr (cadr expr)))
        ((pair? expr)
         (display "(")
         (write-expr (car expr))
         (let loop ((rest (cdr expr)))
           (cond ((null? rest))
                 ((pair? rest) (display " ") (write-expr (car rest)) (loop (cdr rest)))
                 (else (display " . ") (write-expr rest))))
         (display ")"))
        (else
         (write expr))))

;; Prints expression `expr`, evaluates it, and prints the result.
(define-syntax show
  (syntax-rules ()
    ((_ expr)
     (begin
       (write-expr 'expr)
       (newline)
       (display "  ⇒ ")
       (display-result expr)
       (newline)))))

;; Prints a multi-line text indented by two spaces.
(define (display-text text)
  (let loop ((lines (string-split text #\newline)))
    (cond ((null? lines))
          ((and (null? (cdr lines)) (string=? (car lines) "")))
          (else (display* "  | " (car lines))
                (newline)
                (loop (cdr lines))))))

;; Prints a headline for the next section.
(define (section title)
  (newline)
  (display* "=== " title " ===")
  (newline))

;;; Creating YAML values

(section "Creating YAML values")

;; Association lists are mapped to YAML mappings and vectors to YAML sequences. The
;; symbol `null` stands for the YAML null value. Procedure `yaml` returns an
;; immutable YAML value.
(define service
  (yaml '((name . "search")
          (port . 9200)
          (secure . #t)
          (timeout . 2.5)
          (aliases . #("find" "lookup"))
          (owner . null))))

(show service)
(show (yaml 1 "two" #(3)))
(show (yaml "yes"))

;; YAML values are trees of scalars, sequences, and mappings. Every node carries a
;; tag, and optionally a presentation style, an anchor, and a source position.
(show (map yaml-tag (yaml-children (yaml #(1 2.5 "x" #t null)))))
(show (list (yaml-scalar? (yaml 1)) (yaml-sequence? (yaml #(1))) (yaml-mapping? service)))

;; The text of a YAML value is generated by `yaml->string`, which only quotes
;; strings if they would be read back as something else.
(display-text (yaml->string service))
(show (yaml->string #("true" "1.5" "null" "plain" "a: b" "")))
(display-text (yaml->string #("true" "1.5" "null" "plain" "a: b" "")))

;;; Parsing YAML documents

(section "Parsing YAML documents")

;; A deployment manifest with two documents. The first one uses an anchor for the
;; defaults of all services, aliases, and merge keys (`<<`).
(define (lines . strings)
  (apply string-append (map (lambda (str) (string-append str "\n")) strings)))

(define manifest-text
  (lines "# Deployment manifest"
         "defaults: &defaults"
         "  image: registry.example.org/app:1.4"
         "  replicas: 2"
         "  env:"
         "    LOG_LEVEL: info"
         "    FEATURES: [search, export]"
         "services:"
         "  web:"
         "    <<: *defaults"
         "    port: 8080"
         "    replicas: 4"
         "  worker:"
         "    <<: *defaults"
         "    queue: jobs"
         "    replicas: 0"
         "  cache:"
         "    image: redis:7"
         "    port: 6379"
         "    replicas: 1.5"
         "--- # environments"
         "- name: staging"
         "  hosts: [stg-1.example.org]"
         "- name: production"
         "  hosts: [prod-1.example.org, prod-2.example.org]"
         "  replicas-factor: !multiplier 2"))

;; Merge keys are optional, as they are not part of the YAML 1.2 core schema. Without
;; this option, the key `<<` is an ordinary key.
(define documents
  (string->yaml-documents manifest-text '((merge-keys . #t))))

(define manifest (car documents))
(define environments (cadr documents))

(show (length documents))
(show (yaml-keys manifest))
(show (yaml-ref manifest 'services 'worker))
(show (yaml=? (yaml-ref manifest 'services 'web 'env) (yaml-ref manifest 'services 'worker 'env)))

;; A stream without any document is not an error, but a single document is required
;; by `string->yaml`.
(show (string->yaml "# nothing here"))
(show (yaml->value (string->yaml "") 'no-document))

;;; Querying YAML values

(section "Querying YAML values")

;; References select the children of a node. A reference is a sequence index, a
;; mapping key given as symbol, string, or YAML value, or a list of references. The
;; result is `#f` if there is no such node.
(show (yaml-ref manifest 'services 'web 'port))
(show (yaml-ref manifest 'services 'web 'env 'FEATURES 1))
(show (yaml-ref manifest '(services web image)))
(show (yaml-ref manifest 'services 'queue))
(show (yaml-ref environments 1 'hosts))
(show (yaml-member? (yaml-ref manifest 'services) 'web))

;; Procedure `yaml->value` maps YAML values back to Scheme data. The value for missing
;; nodes can be specified as an optional argument.
(show (yaml->value (yaml-ref manifest 'services 'web 'replicas)))
(show (yaml->value (yaml-ref manifest 'services 'web 'host) "localhost"))
(show (yaml->value (yaml-ref manifest 'services 'cache)))

;; Iterate over the entries of a mapping.
(yaml-for-each-entry
  (lambda (name config)
    (display* "  " (yaml->value name) " listens on port "
              (yaml->value (yaml-ref config 'port) "-")
              " with image " (yaml->value (yaml-ref config 'image)))
    (newline))
  (yaml-ref manifest 'services))

;; Tags, styles, anchors, and source positions are available as well. A source
;; position is a list consisting of a line, a column, and a character offset.
(define replicas (yaml-ref manifest 'services 'cache 'replicas))
(define factor (yaml-ref environments 1 'replicas-factor))

(show (list (yaml-tag replicas) (yaml-mark replicas)))
(show (list (yaml-tag factor) (yaml-scalar-text factor)))
(show (list (yaml-style (yaml-ref manifest 'defaults 'env 'FEATURES))
            (yaml-style (yaml-ref manifest 'defaults 'env))))
(show (yaml-anchor (yaml-ref manifest 'defaults)))

;; YAML values can be compared. Mappings are equal if they have the same entries,
;; regardless of the order. Scalars are compared by their value.
(show (yaml=? (string->yaml "{a: 1, b: 2}") (string->yaml "{b: 2, a: 1}")))
(show (yaml=? (string->yaml "0x10") (string->yaml "16")))

;;; Validating YAML values

(section "Validating YAML values")

;; Validation reports the problems of a manifest. Every problem refers to the line
;; of the offending node in the source text.
(define (problem node message)
  (let ((mark (yaml-mark node)))
    (string-append "line " (number->string (if mark (car mark) 0)) ": " message)))

(define (validate-service name config)
  (let ((replicas (yaml-ref config 'replicas))
        (port (yaml-ref config 'port))
        (image (yaml-ref config 'image)))
    (append
      (if (and replicas (yaml-number? replicas) (exact-integer? (yaml->value replicas)))
          (if (< (yaml->value replicas) 1)
              (list (problem replicas (string-append name ": no replicas")))
              '())
          (list (problem (or replicas config)
                         (string-append name ": replicas must be an integer"))))
      (if (and port (not (and (exact-integer? (yaml->value port))
                              (<= 1 (yaml->value port) 65535))))
          (list (problem port (string-append name ": invalid port")))
          '())
      (if (and image (yaml-string? image))
          '()
          (list (problem config (string-append name ": image missing")))))))

(define (validate-manifest manifest)
  (let ((result '()))
    (yaml-for-each-entry
      (lambda (name config)
        (set! result (append result (validate-service (yaml->value name) config))))
      (yaml-ref manifest 'services))
    result))

(for-each (lambda (problem) (display* "  " problem) (newline))
          (validate-manifest manifest))

;;; Changing YAML values

(section "Changing YAML values")

;; Procedure `yaml-replace` returns a modified copy; the original value stays as is.
;; New mapping entries are added at the end of a mapping.
(define fixed-manifest
  (yaml-replace manifest
                '(services worker replicas) 2
                '(services cache replicas) 1
                '(services cache image) "redis:7.2"
                '(services cache labels) '((tier . "data"))))

(show (yaml-ref fixed-manifest 'services 'cache))
(show (yaml-ref manifest 'services 'cache))
(show (validate-manifest fixed-manifest))

;; Mutable YAML values are changed in place.
(define mutable-environments (mutable-yaml environments))

(yaml-set! mutable-environments '(1 name) "prod")
(yaml-set! mutable-environments '(0 hosts 0) "stg-a.example.org")
(yaml-append! mutable-environments '(0 hosts) "stg-b.example.org" "stg-c.example.org")
(yaml-insert! mutable-environments '(1 hosts) 1 "prod-0.example.org")
(yaml-remove! mutable-environments '(0 hosts 1))
(yaml-append! mutable-environments '() '((name . "test") (hosts . #())))

(show mutable-environments)
(show environments)

;; Procedure `yaml` creates an immutable snapshot of a mutable value.
(define snapshot (yaml mutable-environments))
(yaml-remove! mutable-environments 2)
(show (yaml-children-count snapshot))
(show (yaml-children-count mutable-environments))

;;; Writing YAML values

(section "Writing YAML values")

;; The result of `yaml->string` can be tuned with options given as an association list.
(define sample
  (yaml '((name . "demo")
          (ports . #(80 443))
          (labels . ((team . "core") (tier . "web")))
          (notes . "A long description that does not fit on a single line of text."))))

(display-text (yaml->string sample))
(display-text (yaml->string sample '((indentation . 4) (indent-sequences . #f))))
(display-text (yaml->string sample '((flow-style . #t) (sort-keys . #t) (line-width . #f))))
(display-text (yaml->string sample '((line-width . 30) (explicit-start . #t))))

;; Presentation details can be controlled on the level of individual nodes.
(define styled
  (yaml (list (cons 'title (yaml-with-style (yaml "Release notes") 'double-quoted))
              (cons 'body (yaml-with-style (yaml "First line\nSecond line\n") 'literal))
              (cons 'tags (yaml-with-style (yaml #("swift" "yaml")) 'flow))
              (cons 'color (yaml-with-tag (yaml "#ff8800") "!color"))
              (cons 'base (yaml-with-anchor (yaml '((x . 1) (y . 2))) "origin")))))

(display-text (yaml->string styled))

;; Several documents can be written into a single stream.
(display-text (yaml-documents->string (list manifest environments) '((sort-keys . #t))))

;; YAML values can be saved in files, and loaded again. This code writes the fixed
;; manifest and the environments into a file in the temporary directory, and reads the
;; documents back. The merged entries have been written out explicitly.
(define manifest-file
  (path (car (system-directory 'temporary)) "lispkit-yaml-example.yaml"))

(save-yaml-documents manifest-file (list fixed-manifest environments) '((sort-keys . #t)))

(define saved-documents (load-yaml-documents manifest-file))

(show (length saved-documents))
(show (yaml=? (car saved-documents) fixed-manifest))
(show (yaml=? (cadr saved-documents) environments))

(delete-file-or-directory manifest-file)

;;; Interoperability with JSON

(section "Interoperability with JSON")

;; YAML is a superset of JSON. JSON values map directly to YAML values and vice versa.
(define services-json
  (json (yaml->value (yaml-ref manifest 'services 'web))))

(show (json->string services-json #f #t))
(show (yaml (json->value (string->json "{\"a\": [1, 2, {\"b\": null}]}"))))
(show (yaml->string (string->yaml "{\"a\": [1, 2, {\"b\": null}]}") '((flow-style . #f))))

;;; Streaming

(section "Events and streaming")

;; A YAML stream is a sequence of events, which are the low-level representation of
;; anchors and aliases.
(show (map yaml-event-kind (string->yaml-events "a: &x [1, 2]\nb: *x")))

;; The pull parser delivers events on demand. This procedure collects statistics
;; of a document without building any YAML values.
(define (statistics text)
  (let ((parser (make-yaml-parser text))
        (depth 0)
        (max-depth 0)
        (scalars 0)
        (anchors 0)
        (aliases 0))
    (let loop ((event (yaml-parser-next! parser)))
      (unless (eof-object? event)
        (case (yaml-event-kind event)
          ((sequence-start mapping-start)
           (set! depth (+ depth 1))
           (set! max-depth (max depth max-depth))
           (if (yaml-event-anchor event) (set! anchors (+ anchors 1))))
          ((sequence-end mapping-end)
           (set! depth (- depth 1)))
          ((scalar)
           (set! scalars (+ scalars 1))
           (if (yaml-event-anchor event) (set! anchors (+ anchors 1))))
          ((alias)
           (set! aliases (+ aliases 1))))
        (loop (yaml-parser-next! parser))))
    (list (cons 'scalars scalars)
          (cons 'anchors anchors)
          (cons 'aliases aliases)
          (cons 'max-depth max-depth))))

(show (statistics manifest-text))

;; Events can also be created and written directly.
(define (emit-events events)
  (let ((emitter (make-yaml-emitter)))
    (for-each (lambda (event) (yaml-emitter-emit! emitter event)) events)
    (yaml-emitter-output emitter)))

(display-text
  (emit-events
    (list (make-yaml-event 'stream-start)
          (make-yaml-event 'document-start #f)
          (make-yaml-event 'mapping-start 'block)
          (make-yaml-event 'scalar "greeting")
          (make-yaml-event 'scalar "Hello, YAML!" 'double-quoted)
          (make-yaml-event 'scalar "items")
          (make-yaml-event 'sequence-start 'flow)
          (make-yaml-event 'scalar "1")
          (make-yaml-event 'scalar "2")
          (make-yaml-event 'sequence-end)
          (make-yaml-event 'mapping-end)
          (make-yaml-event 'document-end)
          (make-yaml-event 'stream-end))))

;;; Schemas

(section "Schemas")

;; The default core schema reads `yes` as a string. Other schemas resolve plain
;; scalars differently. With the failsafe schema everything is a string.
(show (yaml->value (string->yaml "[yes, 12, 1.5, null]")))
(show (yaml->value (string->yaml "[yes, 12, 1.5, null]" '((schema . failsafe)))))

;; A procedure can define a custom schema. It maps the text of a plain scalar to a
;; tag, or to `#f` if the default behavior should apply. This schema reads the YAML
;; 1.1 spellings of booleans.
(define (yaml-1.1-schema text)
  (and (member (string-downcase text) '("yes" "no" "on" "off" "y" "n")) "!!bool"))

(define legacy (list (cons 'schema yaml-1.1-schema)))

(show (yaml->value (string->yaml "{debug: yes, verbose: off, name: no-op, level: 3}" legacy)))

;; The same schema is used when writing: the string "yes" has to be quoted now.
(show (yaml->string (yaml #("yes" "maybe" "On")) legacy))

;;; Errors

(section "Errors")

;; Syntax errors and invalid data are reported as errors. Their messages include the
;; position of the problem.
(define-syntax try
  (syntax-rules ()
    ((_ expr)
     (guard (condition (#t (list 'error (error-object-message condition))))
       expr))))

(show (try (string->yaml "a: [1, 2")))
(show (try (string->yaml "a: 1\na: 2")))
(show (try (string->yaml "a: *missing")))
(show (try (string->yaml "[[[[1]]]]" '((max-depth . 3)))))
(show (try (string->yaml "a: 1\n---\nb: 2")))
(show (try (yaml '(1 2))))
(show (try (yaml-set! environments '(0 name) "x")))
(show (try (yaml->string 1 '((indentation . 20)))))
(show (try (string->yaml "a" (list (cons 'schema (lambda (text) (error "bad schema")))))))
