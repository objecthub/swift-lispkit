  (test #f (lseq-find-tail even? '()))
  (test #f (lseq-find-tail even? (make-lseq)))
  (test #f (lseq-find-tail negative? (make-lseq 1 2 3 4 5)))
  (test '(2 3 4 5) (lseq-realize (lseq-take (lseq-find-tail even? (nats)) 4)))
  (test '(#f 1) (lseq-find-tail not '(2 #f 1)))
  (test-assert (lseq? (lseq-find-tail even? (make-lseq 3 1 4))))

  (test '(2 18) (lseq-realize (lseq-take-while even? '(2 18 3 10 22 9))))
  (test '(2 18) (lseq-realize (lseq-take-while even? (make-lseq 2 18 3 10 22 9))))
  (test '() (lseq-take-while even? '()))
  (test '() (lseq-take-while even? (make-lseq)))
  (test '() (lseq-take-while even? '(1 2 4)))
  (test '(2 4 6) (lseq-realize (lseq-take-while even? '(2 4 6))))
  (test '(1 2 3 4 5) (lseq-realize (lseq-take-while (lambda (n) (< n 6)) (nats))))
  (test-assert (procedure? (cdr (lseq-take-while even? '(2 18 3 10 22 9)))))
  (event-clear!)
  (lseq-realize (lseq-take-while (lambda (x) (event! x) (< x 3)) (make-lseq 1 2 3 4 5)))
  (test '(1 2 3) (event-ref))

  (test '(3 10 22 9) (lseq-drop-while even? '(2 18 3 10 22 9)))
  (test '(3 10 22 9) (lseq-realize (lseq-drop-while even? (make-lseq 2 18 3 10 22 9))))
  (test '() (lseq-drop-while even? '()))
  (test '() (lseq-drop-while even? (make-lseq)))
  (test '() (lseq-drop-while even? '(2 4 6)))
  (test '() (lseq-drop-while even? (make-lseq 2 4 6)))
  (test '(1 2 3) (lseq-drop-while even? '(1 2 3)))
  (test '(6 7 8) (lseq-realize (lseq-take (lseq-drop-while (lambda (n) (< n 6)) (nats)) 3)))

  (test #t (lseq-any integer? '(a 3 b 2.7)))
  (test #t (lseq-any integer? (make-lseq 'a 3 'b 2.7)))
  (test #f (lseq-any integer? '(a 3.1 b 2.7)))
  (test #f (lseq-any integer? (make-lseq 'a 3.1 'b 2.7)))
  (test #t (lseq-any < '(3 1 4 1 5) '(2 7 1 8 2)))
  (test #t (lseq-any < (make-lseq 3 1 4 1 5) (make-lseq 2 7 1 8 2)))
  (test #f (lseq-any < '(3 1 4 1 5) '(1 1 1 1 1)))
  (test 6 (lseq-any factorial '(-1 -2 3 4)))
  (test 6 (lseq-any factorial (make-lseq -1 -2 3 4)))
  (test #f (lseq-any even? '()))
  (test #f (lseq-any even? (make-lseq)))
  (test #f (lseq-any even? '() '(1 2)))
  (test #t (lseq-any even? (nats)))
  (test #t (lseq-any = (nats) '(5 4 3 2)))
  (test #f (lseq-any = (lseq-take (nats) 4) '(2 3 4 5)))
  (test 'yes (lseq-any (lambda (x) (and (even? x) 'yes)) '(1 3 4)))
  (event-clear!)
  (lseq-any (lambda (x) (event! x) (even? x)) (make-lseq 1 3 4 5 6))
  (test '(1 3 4) (event-ref))

  (test 24 (lseq-every factorial '(1 2 3 4)))
  (test 24 (lseq-every factorial (make-lseq 1 2 3 4)))
  (test #f (lseq-every factorial '(1 2 -3 4)))
  (test #f (lseq-every factorial (make-lseq 1 2 -3 4)))
  (test #t (lseq-every even? '()))
  (test #t (lseq-every even? (make-lseq)))
  (test #t (lseq-every even? '(2 4 6)))
  (test #f (lseq-every even? '(2 3 6)))
  (test #f (lseq-every even? (nats)))
  (test #t (lseq-every = '() '(1 2)))
  (test #t (lseq-every = '(1 2 3) '(1 2 3)))
  (test #f (lseq-every = '(1 2 3) '(1 2 4)))
  (test #t (lseq-every = '(1 2) (nats)))
  (test 6 (lseq-every * '(1 2 3) '(1 1 2)))
  (test #f (lseq-every (lambda (a b) (and (> b 0) (* a b))) '(1 2 3) '(1 0 2)))
  (event-clear!)
  (lseq-every (lambda (x) (event! x) (even? x)) (make-lseq 2 4 5 6))
  (test '(2 4 5) (event-ref))

  (test 2 (lseq-index even? '(3 1 4 1 5 9)))
  (test 2 (lseq-index even? (make-lseq 3 1 4 1 5 9)))
  (test 1 (lseq-index < '(3 1 4 1 5 9 2 5 6) '(2 7 1 8 2)))
  (test 1 (lseq-index < (make-lseq 3 1 4 1 5 9 2 5 6) (make-lseq 2 7 1 8 2)))
  (test #f (lseq-index = '(3 1 4 1 5 9 2 5 6) '(2 7 1 8 2)))
  (test #f (lseq-index even? '()))
  (test #f (lseq-index even? (make-lseq)))
  (test #f (lseq-index even? '(1 3 5)))
  (test 0 (lseq-index even? '(2 3 5)))
  (test 9 (lseq-index (lambda (n) (> n 9)) (nats)))
  (test 3 (lseq-index = (nats) '(9 9 9 4)))

  (test '(a b c) (lseq-memq 'a '(a b c)))
  (test '(b c) (lseq-memq 'b '(a b c)))
  (test '(a b c) (lseq-realize (lseq-memq 'a '(a b c))))
