(import (lispkit base)
        (lispkit test)
        (srfi 1)
        (srfi 127)
        (srfi 158)
        (prefix (scheme lseq) scheme:))

(test-begin "SRFI 127: Lazy Sequences")

;; Make-generator for tests cloned from SRFI 121
(define (make-generator . args)
  (lambda ()
    (if (null? args)
        (eof-object)
        (let ((next (car args)))
          (set! args (cdr args))
          next))))

;; Make-lseq creates an lseq, like list, but guarantees the use of a generator.
(define (make-lseq . args)
  (generator->lseq (apply make-generator args)))

;; An infinite lseq 1, 2, 3, ...
(define (nats)
  (generator->lseq (make-iota-generator +inf.0 1 1)))

;; An lseq of the given elements. Each time an element is pulled from the underlying
;; generator, the procedure `note!` is invoked with the pulled element.
(define (noting-lseq note! . args)
  (generator->lseq
    (lambda ()
      (if (null? args)
          (eof-object)
          (let ((next (car args)))
            (set! args (cdr args))
            (note! next)
            next)))))

(define (factorial n)
  (cond
    ((< n 0) #f)
    ((= n 0) 1)
    (else (* n (factorial (- n 1))))))

;; Recording of side effects
(define events '())
(define (event! x) (set! events (cons x events)))
(define (event-clear!) (set! events '()))
(define (event-ref) (reverse events))

(test-group "Library (scheme lseq)"
  (test-assert (eq? scheme:generator->lseq generator->lseq))
  (test-assert (eq? scheme:lseq? lseq?))
  (test-assert (eq? scheme:lseq=? lseq=?))
  (test-assert (eq? scheme:lseq-car lseq-car))
  (test-assert (eq? scheme:lseq-cdr lseq-cdr))
  (test-assert (eq? scheme:lseq-first lseq-first))
  (test-assert (eq? scheme:lseq-rest lseq-rest))
  (test-assert (eq? scheme:lseq-ref lseq-ref))
  (test-assert (eq? scheme:lseq-take lseq-take))
  (test-assert (eq? scheme:lseq-drop lseq-drop))
  (test-assert (eq? scheme:lseq-realize lseq-realize))
  (test-assert (eq? scheme:lseq->generator lseq->generator))
  (test-assert (eq? scheme:lseq-length lseq-length))
  (test-assert (eq? scheme:lseq-append lseq-append))
  (test-assert (eq? scheme:lseq-zip lseq-zip))
  (test-assert (eq? scheme:lseq-map lseq-map))
  (test-assert (eq? scheme:lseq-for-each lseq-for-each))
  (test-assert (eq? scheme:lseq-filter lseq-filter))
  (test-assert (eq? scheme:lseq-remove lseq-remove))
  (test-assert (eq? scheme:lseq-find lseq-find))
  (test-assert (eq? scheme:lseq-find-tail lseq-find-tail))
  (test-assert (eq? scheme:lseq-any lseq-any))
  (test-assert (eq? scheme:lseq-every lseq-every))
  (test-assert (eq? scheme:lseq-index lseq-index))
  (test-assert (eq? scheme:lseq-take-while lseq-take-while))
  (test-assert (eq? scheme:lseq-drop-while lseq-drop-while))
  (test-assert (eq? scheme:lseq-member lseq-member))
  (test-assert (eq? scheme:lseq-memq lseq-memq))
  (test-assert (eq? scheme:lseq-memv lseq-memv)))

(test-group "Constructors"
  (let ((one23 (make-lseq 1 2 3)))
    (test 1 (car one23))
    (test-assert (procedure? (cdr one23)))
    (test '(1 2 3) (lseq-realize one23)))
  (test '() (make-lseq))
  (test '(1) (lseq-realize (make-lseq 1)))
  (test-assert (pair? (make-lseq 1)))
  (test-assert (null? (make-lseq)))
  (test-assert (procedure? (cdr (make-lseq 1))))
  (test-error (generator->lseq 1))
  (test-error (generator->lseq '(1 2 3)))
  (test-error (generator->lseq))
  ;; Example from the SRFI
  (test '(1 2 3) (lseq-realize (lseq-take (generator->lseq (make-iota-generator +inf.0 1)) 3)))
  ;; Prepending elements
  (test '(0 1 2) (lseq-realize (cons 0 (make-lseq 1 2))))
  (test '(a b 1 2) (lseq-realize (cons* 'a 'b (make-lseq 1 2))))
  (test '(0 1 2 3) (lseq-realize (cons 0 '(1 2 3))))
  (test 0 (lseq-car (cons 0 (make-lseq 1 2))))
  (test 1 (lseq-car (lseq-cdr (cons 0 (make-lseq 1 2)))))
  ;; The elements of a generator can be arbitrary objects
  (test '(#f () #t "x" #\a (1 2) #(1 2)) (lseq-realize (make-lseq #f '() #t "x" #\a '(1 2) #(1 2))))
  (test '(1) (lseq-realize (generator->lseq (generator 1)))))

(test-group "Predicates"
  (test-assert (lseq? '()))
  (test-assert (lseq? '(1 2 3)))
  (test-assert (lseq? '(1)))
  (test-assert (lseq? (make-lseq)))
  (test-assert (lseq? (make-lseq 1 2 3)))
  (test-assert (lseq? (cons 'x (lambda () 'x))))
  (test-assert (lseq? (cons 1 (cons 2 (lambda () (eof-object))))))
  (test-assert (lseq? (cons 0 (make-lseq 1 2))))
  (test-assert (lseq? (lseq-cdr (make-lseq 1 2 3))))
  (test-assert (lseq? (lseq-take '(1 2 3) 2)))
  (test-assert (lseq? (nats)))
  (test-not (lseq? 1))
  (test-not (lseq? 'a))
  (test-not (lseq? "abc"))
  (test-not (lseq? #t))
  (test-not (lseq? #f))
  (test-not (lseq? (vector 1 2 3)))
  (test-not (lseq? (lambda () 1)))
  (test-not (lseq? (make-generator 1 2 3)))
  (test-not (lseq? '(1 . 2)))
  (test-not (lseq? '(1 2 . 3)))
  (test-not (lseq? (cons 1 (cons 2 3))))

  (test-assert (lseq=? = '() '()))
  (test-assert (lseq=? = '(1 2 3) '(1 2 3)))
  (test-assert (lseq=? = (make-lseq 1 2 3) (make-lseq 1 2 3)))
  (test-assert (lseq=? = (make-lseq 1 2 3) '(1 2 3)))
  (test-assert (lseq=? = '(1 2 3) (make-lseq 1 2 3)))
  (test-assert (lseq=? = (make-lseq) '()))
  (test-assert (lseq=? = '() (make-lseq)))
  (test-not (lseq=? = '(1 2 3) '(1 2)))
  (test-not (lseq=? = '(1 2) '(1 2 3)))
  (test-not (lseq=? = '(1 2 3) '(1 2 4)))
  (test-not (lseq=? = (make-lseq 1 2 3) (make-lseq 1 2)))
  (test-not (lseq=? = (make-lseq 1 2) (make-lseq 1 2 3)))
  (test-not (lseq=? = '() '(1)))
  (test-not (lseq=? = '(1) '()))
  (test-not (lseq=? = (make-lseq) (make-lseq 1)))
  (test-not (lseq=? = (make-lseq 1) (make-lseq)))
  (test-assert (lseq=? eq? '(a b c) (make-lseq 'a 'b 'c)))
  (test-assert (lseq=? equal? '((1) (2)) (make-lseq '(1) '(2))))
  (test-not (lseq=? eq? '((1) (2)) (list (list 3) (list 2))))
  (test-assert (lseq=? (lambda (x y) (= (* 2 x) y)) '(1 2 3) (make-lseq 2 4 6)))
  (test-not (lseq=? (lambda (x y) (= (* 2 x) y)) '(2 4 6) (make-lseq 1 2 3)))
  ;; The first argument of the equality predicate is from the first lseq
  (test-assert (lseq=? < '(1 2 3) '(2 3 4)))
  (test-not (lseq=? > '(1 2 3) '(2 3 4)))
  (test-not (lseq=? = (lseq-take (nats) 3) (nats))))

(test-group "Selectors"
  (test-error (lseq-car (make-generator)))
  (test 1 (lseq-car (make-lseq 1 2 3)))
  (test 1 (lseq-car '(1 2 3)))
  (test-error (lseq-car 2))
  (test-error (lseq-car '()))
  (test-error (lseq-car (make-lseq)))

  (test-error (lseq-first (make-generator)))
  (test 1 (lseq-first (make-lseq 1 2 3)))
  (test 1 (lseq-first '(1 2 3)))
  (test-error (lseq-first 2))
  (test-error (lseq-first '()))

  (test-error (lseq-cdr (make-generator)))
  (test 2 (lseq-cdr '(1 . 2)))
  (test 2 (lseq-car (lseq-cdr '(1 2 3))))
  (test 2 (lseq-car (lseq-cdr (make-lseq 1 2 3))))
  (test '(2 3) (lseq-cdr '(1 2 3)))
  (test '() (lseq-cdr '(1)))
  (test '() (lseq-cdr (make-lseq 1)))
  (test '(2 3) (lseq-realize (lseq-cdr (make-lseq 1 2 3))))
  (test-error (lseq-cdr '()))
  (test-error (lseq-cdr (make-lseq)))
  (test-error (lseq-cdr 2))

  (test-error (lseq-rest (make-generator)))
  (test 2 (lseq-rest '(1 . 2)))
  (test 2 (lseq-car (lseq-rest '(1 2 3))))
  (test 2 (lseq-car (lseq-rest (make-lseq 1 2 3))))
  (test-error (lseq-rest 2))
  (test '() (lseq-rest (make-lseq 1)))
  (test '(2 3) (lseq-realize (lseq-rest (make-lseq 1 2 3))))

  (test-error (lseq-ref '() 0))
  (test 1 (lseq-ref '(1) 0))
  (test 2 (lseq-ref '(1 2) 1))
  (test 'c (lseq-ref '(a b c d) 2))
  (test-error (lseq-ref '(a b c d) 4))
  (test-error (lseq-ref '(a b c d) 5))
  (test-error (lseq-ref (make-lseq) 0))
  (test 1 (lseq-ref (make-lseq 1) 0))
  (test 1 (lseq-ref (make-lseq 1 2) 0))
  (test 2 (lseq-ref (make-lseq 1 2) 1))
  (test-error (lseq-ref (make-lseq 1 2) 2))
  (test 1000 (lseq-ref (nats) 999))
  (test-error (lseq-ref '(1 2 3) -1))
  (test-error (lseq-ref '(1 2 3) 1.0))
  (test-error (lseq-ref '(1 2 3) 'a))

  (test-error (lseq-take '() 1))
  (test-error (lseq-take (make-lseq) 1))
  (test-assert (procedure? (cdr (lseq-take '(1 2 3 4 5) 3)))) ; test laziness
  (test '(1 2 3) (lseq-realize (lseq-take '(1 2 3 4 5) 3)))
  (test '(a b) (lseq-realize (lseq-take '(a b c d e) 2)))
  (test '() (lseq-take '() 0))
  (test '() (lseq-take '(1 2 3) 0))
  (test '() (lseq-take (make-lseq 1 2 3) 0))
  (test '(1) (lseq-realize (lseq-take '(1 2 3) 1)))
  (test '(1 2 3) (lseq-realize (lseq-take '(1 2 3) 3)))
  (test '(1 2 3) (lseq-realize (lseq-take (make-lseq 1 2 3) 3)))
  (test '(1 2 3) (lseq-realize (lseq-take (nats) 3)))
  (test-error (lseq-realize (lseq-take '(1 2 3) 4)))
  (test-error (lseq-realize (lseq-take (make-lseq 1 2 3) 4)))
  (test-error (lseq-take '(1 2 3) -1))
  (test-error (lseq-take '(1 2 3) 1.5))

  (test-error (lseq-drop '() 1))
  (test-error (lseq-drop (make-lseq 1) 2))
  (test '(3 4 5) (lseq-drop '(1 2 3 4 5) 2))
  (test '(3 4 5) (lseq-realize (lseq-drop '(1 2 3 4 5) 2)))
  (test '(3 4 5) (lseq-realize (lseq-drop (make-lseq 1 2 3 4 5) 2)))
  (test '(1 2 3) (lseq-drop '(1 2 3) 0))
  (test '() (lseq-drop '(1 2 3) 3))
  (test '() (lseq-drop (make-lseq 1 2 3) 3))
  (test '(1 2 3) (lseq-realize (lseq-drop (make-lseq 1 2 3) 0)))
  (test 11 (lseq-car (lseq-drop (nats) 10)))
  (test-error (lseq-drop '(1 2 3) 4))
  (test-error (lseq-drop '(1 2 3) -1))
  (test-error (lseq-drop '(1 2 3) 'a)))

(test-group "The whole lazy sequence"
  (test '() (lseq-realize '()))
  (test '(1 2 3) (lseq-realize '(1 2 3)))
  (test '() (lseq-realize (make-lseq)))
  (test '(1 2 3) (lseq-realize (make-lseq 1 2 3)))
  (test-assert (list? (lseq-realize (make-lseq 1 2 3))))
  (test '(1 2 3 4) (lseq-realize (cons 1 (cons 2 (make-lseq 3 4)))))
  (test-error (lseq-realize 1))
  (test-error (lseq-realize '(1 2 . 3)))

  (let ((g (lseq->generator '(1 2 3))))
    (test 1 (g))
    (test 2 (g))
    (test 3 (g))
    (test-assert (eof-object? (g)))
    (test-assert (eof-object? (g))))

  (let ((g (lseq->generator (make-lseq 1 2 3))))
    (test 1 (g))
    (test 2 (g))
    (test 3 (g))
    (test-assert (eof-object? (g)))
    (test-assert (eof-object? (g))))

  (let ((g (lseq->generator '())))
    (test-assert (eof-object? (g))))

  (let ((g (lseq->generator (make-lseq))))
    (test-assert (eof-object? (g))))

  (let ((g (lseq->generator (nats))))
    (test 1 (g))
    (test 2 (g))
    (test 3 (g)))

  (test '(1 2 3) (generator->list (lseq->generator (make-lseq 1 2 3))))
  (test '(1 2 3) (lseq-realize (generator->lseq (lseq->generator '(1 2 3)))))
  (test '(1 2 3 4 5) (generator->list (gtake (lseq->generator (nats)) 5)))

  (test 0 (lseq-length '()))
  (test 3 (lseq-length '(1 2 3)))
  (test 0 (lseq-length (make-lseq)))
  (test 1 (lseq-length (make-lseq 1)))
  (test 3 (lseq-length (make-lseq 1 2 3)))
  (test 5 (lseq-length (lseq-take (nats) 5)))
  (test-error (lseq-length 1))
  (test-error (lseq-length '(1 2 . 3)))

  (test '() (lseq-append))
  (test '() (lseq-append '()))
  (test '() (lseq-append '() '()))
  (test '() (lseq-append (make-lseq) (make-lseq)))
  (test '(1 2 3) (lseq-realize (lseq-append '(1 2 3))))
  (test '(1 2 3) (lseq-realize (lseq-append (make-lseq 1 2 3))))
  (test '(1 2 3 a b c) (lseq-realize (lseq-append '(1 2 3) '(a b c))))
  (test '(1 2 3) (lseq-realize (lseq-append '() '(1 2 3))))
  (test '(1 2 3) (lseq-realize (lseq-append '(1 2 3) '())))
  (test '(1 2 3) (lseq-realize (lseq-append '() '() '(1 2 3) '() '())))
  (test '(1 2 3 4 5 6) (lseq-realize (lseq-append '(1) '(2 3) '(4 5 6))))
  (test '(1 2 3 4 5 6) (lseq-realize (lseq-append (make-lseq 1) (make-lseq 2 3) '(4 5 6))))
  (test '(1 2 3 4 5 6 7 8 9) (lseq-realize (lseq-append (make-lseq) (make-lseq 1 2 3) (make-lseq)
                                                        (make-lseq 4 5 6) '() '(7 8 9))))
  (let ((one23abc (lseq-append (make-lseq 1 2 3) (make-lseq 'a 'b 'c))))
    (test-assert (procedure? (cdr one23abc)))
    (test-assert (lseq-realize one23abc))
    (test '(1 2 3 a b c) (lseq-realize one23abc)))
  (test '(1 2 1 2 3) (lseq-realize (lseq-take (lseq-append '(1 2) (nats)) 5)))
  (test '(a b c) (lseq-realize (lseq-take (lseq-append '(a b c) (nats)) 3)))
  (let ()
    (define (gen . xs)
      (let ((l xs))
        (generator->lseq
          (lambda ()
            (if (null? l)
                (eof-object)
                (let ((x (car l)))
                  (set! l (cdr l))
                  x))))))
    (test '(1 2 3 a b) (lseq-realize (lseq-append (gen 1 2 3) (gen 'a 'b)))))

  (let ((one2345 (make-lseq 1 2 3 4 5))
        (oddeven (make-lseq 'odd 'even 'odd 'even 'odd 'even 'odd 'even)))
    (test '((one 1 odd) (two 2 even) (three 3 odd))
          (lseq-realize (lseq-zip '(one two three) one2345 oddeven))))
  (test '((one 1 odd) (two 2 even) (three 3 odd))
        (lseq-realize (lseq-zip '(one two three)
                                (nats)
                                (generator->lseq (circular-generator 'odd 'even)))))
  (test '((1) (2) (3)) (lseq-realize (lseq-zip '(1 2 3))))
  (test '((1) (2) (3)) (lseq-realize (lseq-zip (make-lseq 1 2 3))))
  (test '() (lseq-zip '()))
  (test '() (lseq-zip '() '(1 2 3)))
  (test '() (lseq-zip '(1 2 3) '()))
  (test '() (lseq-zip (make-lseq) (nats)))
  (test '((1 a) (2 b)) (lseq-realize (lseq-zip '(1 2 3) '(a b))))
  (test '((1 a) (2 b)) (lseq-realize (lseq-zip '(1 2) '(a b c))))
  (test '((1 a x) (2 b y)) (lseq-realize (lseq-zip '(1 2) '(a b) '(x y z))))
  (test '((1 1) (2 2) (3 3)) (lseq-realize (lseq-take (lseq-zip (nats) (nats)) 3))))

(test-group "Mapping and filtering"
  (test '() (lseq-map - '()))
  (test '() (lseq-map - (make-lseq)))
  (test '(-1 -2 -3) (lseq-realize (lseq-map - '(1 2 3))))
  (test '(-1 -2 -3) (lseq-realize (lseq-map - (make-lseq 1 2 3))))
  (test-assert (procedure? (cdr (lseq-map - '(1 2 3)))))
  (test '(b e h) (lseq-realize (lseq-map (lambda (x) (lseq-car (lseq-cdr x)))
                                         '((a b) (d e) (g h)))))
  (test '(1 4 27 256 3125) (lseq-realize (lseq-take (lseq-map (lambda (n) (expt n n)) (nats)) 5)))
  (test '(5 7 9) (lseq-realize (lseq-map + '(1 2 3) '(4 5 6))))
  (test '(5 7 9) (lseq-realize (lseq-map + (make-lseq 1 2 3) (make-lseq 4 5 6))))
  (test '(5 7) (lseq-realize (lseq-map + '(1 2 3) '(4 5))))
  (test '(5 7) (lseq-realize (lseq-map + '(1 2) '(4 5 6))))
  (test '(12 15) (lseq-realize (lseq-map + '(1 2) '(4 5 6) '(7 8 9))))
  (test '(2 4 6) (lseq-realize (lseq-take (lseq-map + (nats) (nats)) 3)))
  (test '((1 . a) (2 . b)) (lseq-realize (lseq-map cons '(1 2) '(a b))))
  (test '() (lseq-map + '() '(1 2)))
  (test '() (lseq-map + '(1 2) '()))
  (test '(1 2) (let ((count 0))
                 (lseq-realize
                   (lseq-map (lambda (ignored)
                               (set! count (+ count 1))
                               count)
                             '(a b)))))

  (let* ((output '())
         (out! (lambda (x) (set! output (cons x output)))))
    (lseq-for-each out! '())
    (test '() output)
    (lseq-for-each out! '(a b c))
    (test '(c b a) output)
    (lseq-for-each out! (make-lseq 1 2 3))
    (test '(3 2 1 c b a) output)
    (lseq-for-each out! (make-lseq))
    (test '(3 2 1 c b a) output))
  (test #(0 1 4 9 16)
        (let ((v (make-vector 5)))
          (lseq-for-each (let ((count 0))
                           (lambda (i)
                             (vector-set! v count (* i i))
                             (set! count (+ count 1))))
                         '(0 1 2 3 4))
          v))
  (let ((sum 0))
    (lseq-for-each (lambda (x y) (set! sum (+ sum (* x y)))) '(1 2 3) (make-lseq 4 5 6))
    (test 32 sum))
  (let ((sum 0))
    (lseq-for-each (lambda (x y) (set! sum (+ sum (* x y)))) '(1 2 3) '(4 5))
    (test 14 sum))
  (let ((sum 0))
    (lseq-for-each (lambda (x y) (set! sum (+ sum (* x y)))) '(1 2) (nats))
    (test 5 sum))
  (event-clear!)
  (lseq-for-each event! (make-lseq 1 2 3))
  (test '(1 2 3) (event-ref))

  (test '() (lseq-filter odd? '()))
  (test '() (lseq-filter odd? (make-lseq)))
  (test '() (lseq-filter odd? '(2 4 6)))
  (test '() (lseq-filter odd? (make-lseq 2 4 6)))
  (let ((odds (lseq-filter odd? '(1 2 3 4 5))))
    (test-assert (procedure? (cdr odds)))
    (test '(1 3 5) (lseq-realize odds))
    (test '(1 3 5) (lseq-realize (lseq-filter odd? (make-lseq 1 2 3 4 5)))))
  (test '(1 3) (lseq-realize (lseq-filter odd? (generator->lseq (make-range-generator 1 5)))))
  (test '(2 4 6 8 10) (lseq-realize (lseq-take (lseq-filter even? (nats)) 5)))
  (test '(1 3 5) (lseq-realize (lseq-filter odd? '(1 3 5))))
  (test '(6) (lseq-realize (lseq-filter even? '(1 3 6))))

  (test '() (lseq-remove even? '()))
  (test '() (lseq-remove even? (make-lseq)))
  (test '() (lseq-remove even? '(2 4 6)))
  (let ((odds (lseq-remove even? '(1 2 3 4 5))))
    (test-assert (procedure? (cdr odds)))
    (test '(1 3 5) (lseq-realize odds))
    (test '(1 3 5) (lseq-realize (lseq-remove even? (make-lseq 1 2 3 4 5)))))
  (test '(2 4) (lseq-realize (lseq-remove odd? (generator->lseq (make-range-generator 1 5)))))
  (test '(1 3 5 7 9) (lseq-realize (lseq-take (lseq-remove even? (nats)) 5)))

  ;; pred is called in sequence order
  (event-clear!)
  (lseq-realize (lseq-filter (lambda (x) (event! x) (odd? x)) (make-lseq 1 2 3 4 5)))
  (test '(1 2 3 4 5) (event-ref))
  (event-clear!)
  (lseq-realize (lseq-remove (lambda (x) (event! x) (odd? x)) (make-lseq 1 2 3 4 5)))
  (test '(1 2 3 4 5) (event-ref)))

