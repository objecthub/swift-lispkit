(test-group "Comparators: make-improper-ilist-comparator"
  (let ((c (make-improper-ilist-comparator real-comparator)))
    (test-assert (comparator? c))
    ;; Type test
    (test-assert (comparator-test-type c '()))
    (test-assert (comparator-test-type c 5))
    (test-assert (comparator-test-type c '(1 2 3)))
    (test-assert (comparator-test-type c '(1 2 . 3)))
    (test-assert (comparator-test-type c '(1 . 2)))
    (test-assert (not (comparator-test-type c 'a)))
    (test-assert (not (comparator-test-type c '(1 2 . a))))
    (test-assert (not (comparator-test-type c '(1 a 3))))
    ;; Equality
    (test-assert (=? c '() '()))
    (test-assert (=? c 5 5))
    (test-assert (=? c '(1 2 3) '(1 2 3)))
    (test-assert (=? c '(1 2 . 3) '(1 2 . 3)))
    (test-assert (not (=? c '(1 2 . 3) '(1 2 . 4))))
    (test-assert (not (=? c '(1 2 . 3) '(1 2 3))))
    (test-assert (not (=? c '(1 2) '(1 2 . 3))))
    (test-assert (not (=? c '() 5)))
    (test-assert (not (=? c '(1) 1)))
    ;; Ordering: () < ipairs < other objects
    (test-assert (<? c '() '(1)))
    (test-assert (<? c '() 0))
    (test-assert (<? c '(100) 0))
    (test-assert (not (<? c 0 '(100))))
    (test-assert (not (<? c '(1) '())))
    (test-assert (not (<? c '() '())))
    (test-assert (<? c 1 2))
    (test-assert (<? c '(1 2) '(1 3)))
    (test-assert (<? c '(1 2) '(1 2 3)))
    (test-assert (<? c '(1 2) '(1 2 . 3)))
    (test-assert (<? c '(1 2 . 3) '(1 2 . 4)))
    (test-assert (<? c '(1 2 3) '(1 2 . 3)))
    (test-assert (not (<? c '(1 2 . 3) '(1 2 3))))
    (test-assert (<? c '(1 . 2) '(2 . 1)))
    (test-assert (not (<? c '(2 . 1) '(1 . 2))))
    (test-assert (not (<? c '(1 2 . 3) '(1 2 . 3))))
    ;; Hashing
    (test (comparator-hash c '(1 2 . 3)) (comparator-hash c (cons 1 (cons 2 3))))
    (test (comparator-hash c 5) (comparator-hash c 5))
    (test-assert (exact-integer? (comparator-hash c '(1 2 3)))))
  ;; Comparators that cannot order objects, or hash them
  (let ((c (make-improper-ilist-comparator (make-comparator number? = #f #f))))
    (test-assert (comparator-test-type c '(1 2 . 3)))
    (test-assert (=? c '(1 2 . 3) '(1 2 . 3)))
    (test-assert (not (comparator-ordered? c)))
    (test-assert (not (comparator-hashable? c)))))

(test-group "Comparators: make-icar-comparator and make-icdr-comparator"
  (let ((car-c (make-icar-comparator real-comparator))
        (cdr-c (make-icdr-comparator real-comparator)))
    (test-assert (comparator? car-c))
    (test-assert (comparator-test-type car-c '(1 . x)))
    (test-assert (comparator-test-type car-c '(1 x y)))
    (test-assert (not (comparator-test-type car-c '(x . 1))))
    (test-assert (not (comparator-test-type car-c '())))
    (test-assert (not (comparator-test-type car-c 1)))
    (test-assert (=? car-c '(1 . x) '(1 . y)))
    (test-assert (not (=? car-c '(1 . x) '(2 . x))))
    (test-assert (<? car-c '(1 . z) '(2 . a)))
    (test-assert (not (<? car-c '(1 . z) '(1 . a))))
    (test (comparator-hash car-c '(1 . x)) (comparator-hash car-c '(1 . y)))
    (test-assert (comparator-test-type cdr-c '(x . 1)))
    (test-assert (not (comparator-test-type cdr-c '(1 . x))))
    (test-assert (not (comparator-test-type cdr-c 1)))
    (test-assert (=? cdr-c '(x . 1) '(y . 1)))
    (test-assert (not (=? cdr-c '(x . 1) '(x . 2))))
    (test-assert (<? cdr-c '(z . 1) '(a . 2)))
    (test (comparator-hash cdr-c '(x . 1)) (comparator-hash cdr-c '(y . 1)))))

(test-group "Comparators: sorting and equality of mixed objects"
  (let ((c (make-improper-ilist-comparator real-comparator)))
    (test '(() (1) (1 2) (1 2 . 3) (1 3) (2) 0 5)
          (list-sort (lambda (a b) (<? c a b))
                     '((2) 5 (1 3) () 0 (1 2 . 3) (1) (1 2))))))

(test-end)
